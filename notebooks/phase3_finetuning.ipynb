  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step2"
   },
   "source": [
    "## Step 2: HuggingFace Authentication"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "hf_auth"
   },
   "outputs": [],
   "source": [
    "from google.colab import userdata\n",
    "from huggingface_hub import HfApi\n",
    "\n",
    "# Get token from Colab secrets (add HF_TOKEN in Colab Settings > Secrets)\n",
    "HF_TOKEN = userdata.get('HF_TOKEN')\n",
    "\n",
    "# Verify access\n",
    "api = HfApi(token=HF_TOKEN)\n",
    "user = api.whoami()\n",
    "print(f\"Authenticated as: {user['name']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step3"
   },
   "source": [
    "## Step 3: Mount Google Drive"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "mount_drive"
   },
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "import os\n",
    "\n",
    "drive.mount('/content/drive')\n",
    "OUTPUT_DIR = '/content/drive/MyDrive/docchat-lora-adapter'\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "print(f\"Output directory: {OUTPUT_DIR}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step4"
   },
   "source": [
    "## Step 4: Prepare Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "load_dataset"
   },
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "# Load the JSONL dataset from project repo (upload to HF Hub or provide path)\n",
    "# For now, we'll create a small synthetic dataset inline\n",
    "\n",
    "synthetic_data = [\n",
    "    # Grounded examples (answer from context)\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context. If the context doesn't contain the answer, say so.\",\n",
    "        \"input\": \"Context: Nigeria has a population of 218.5 million. France has 67.8 million.\\nQuestion: Which country has the larger population?\",\n",
    "        \"output\": \"Nigeria has the larger population with 218.5 million people compared to France's 67.8 million.\"\n",
    "    },\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context. If the context doesn't contain the answer, say so.\",\n",
    "        \"input\": \"Context: The Paris Agreement was signed in 2015 by 195 countries.\\nQuestion: When was the Paris Agreement signed?\",\n",
    "        \"output\": \"The Paris Agreement was signed in 2015.\"\n",
    "    },\n",
    "    # Refusal examples (not in context)\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context. If the context doesn't contain the answer, say so.\",\n",
    "        \"input\": \"Context: The Amazon rainforest is home to 10% of known species.\\nQuestion: How many dinosaur species lived in the Amazon?\",\n",
    "        \"output\": \"I do not have information about dinosaur species in the Amazon in the provided context.\"\n",
    "    },\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context. If the context doesn't contain the answer, say so.\",\n",
    "        \"input\": \"Context: Solar panel efficiency improved from 15% to 23% between 2010 and 2023.\\nQuestion: What is the boiling point of water?\",\n",
    "        \"output\": \"The provided context does not contain information about the boiling point of water.\"\n",
    "    },\n",
    "]\n",
    "\n",
    "# In production, replace with:\n",
    "# dataset = load_dataset('json', data_files='path/to/dataset.jsonl', split='train')\n",
    "# For the real fine-tuning, run the dataset generation script first (T3.3)\n",
    "\n",
    "print(f\"Loaded {len(synthetic_data)} synthetic examples\")\n",
    "print(\"In production, replace with 400+ real examples from dataset.jsonl\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step5"
   },
   "source": [
    "## Step 5: Load Model with QLoRA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "load_model"
   },
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import (\n",
    "    AutoModelForCausalLM,\n",
    "    AutoTokenizer,\n",
    "    BitsAndBytesConfig,\n",
    "    TrainingArguments,\n",
    ")\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
    "from trl import SFTTrainer\n",
    "\n",
    "MODEL_ID = \"meta-llama/Llama-3.2-3B-Instruct\"\n",
    "\n",
    "# QLoRA config: 4-bit quantization\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,\n",
    ")\n",
    "\n",
    "# Load tokenizer\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, token=HF_TOKEN)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "tokenizer.padding_side = \"right\"\n",
    "\n",
    "# Load model in 4-bit\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_ID,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    token=HF_TOKEN,\n",
    ")\n",
    "\n",
    "# Prepare for k-bit training\n",
    "model = prepare_model_for_kbit_training(model)\n",
    "\n",
    "# LoRA configuration\n",
    "lora_config = LoraConfig(\n",
    "    r=16,\n",
    "    lora_alpha=32,\n",
    "    lora_dropout=0.05,\n",
    "    bias=\"none\",\n",
    "    task_type=\"CAUSAL_LM\",\n",
    "    target_modules=[\n",
    "        \"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n",
    "        \"gate_proj\", \"up_proj\", \"down_proj\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, lora_config)\n",
    "model.print_trainable_parameters()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step6"
   },
   "source": [
    "## Step 6: Format Dataset for Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "format_data"
   },
   "outputs": [],
   "source": [
    "def format_prompt(example):\n",
    "    \"\"\"Format example into Llama-3.2 chat template.\"\"\"\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": example[\"instruction\"]},\n",
    "        {\"role\": \"user\", \"content\": example[\"input\"]},\n",
    "        {\"role\": \"assistant\", \"content\": example[\"output\"]},\n",
    "    ]\n",
    "    return tokenizer.apply_chat_template(\n",
    "        messages, tokenize=False\n",
    "    )\n",
    "\n",
    "# Format all examples\n",
    "formatted = [format_prompt(ex) for ex in synthetic_data]\n",
    "\n",
    "print(\"Example formatted prompt:\")\n",
    "print(formatted[0][:500] + \"...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step7"
   },
   "source": [
    "## Step 7: Train with SFTTrainer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "train"
   },
   "outputs": [],
   "source": [
    "training_args = TrainingArguments(\n",
    "    output_dir=OUTPUT_DIR,\n",
    "    num_train_epochs=3,\n",
    "    per_device_train_batch_size=2,\n",
    "    gradient_accumulation_steps=4,\n",
    "    learning_rate=2e-4,\n",
    "    fp16=True,\n",
    "    logging_steps=5,\n",
    "    save_steps=50,\n",
    "    save_total_limit=2,\n",
    "    optim=\"paged_adamw_8bit\",\n",
    "    lr_scheduler_type=\"cosine\",\n",
    "    warmup_ratio=0.03,\n",
    "    report_to=[\"none\"],  # Disable wandb/tensorboard\n",
    ")\n",
    "\n",
    "# Tokenize formatted prompts\n",
    "def tokenize(examples):\n",
    "    return tokenizer(\n",
    "        examples,\n",
    "        truncation=True,\n",
    "        max_length=1024,\n",
    "        padding=False,\n",
    "    )\n",
    "\n",
    "# Create a simple dataset from formatted strings\n",
    "from datasets import Dataset\n",
    "\n",
    "ds = Dataset.from_dict({\"text\": formatted})\n",
    "ds = ds.map(lambda x: tokenize(x[\"text\"]), batched=False, remove_columns=[\"text\"])\n",
    "\n",
    "# Train\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=ds,\n",
    "    peft_config=lora_config,\n",
    ")\n",
    "\n",
    "trainer.train()\n",
    "\n",
    "# Save the final adapter\n",
    "model.save_pretrained(OUTPUT_DIR)\n",
    "tokenizer.save_pretrained(OUTPUT_DIR)\n",
    "print(f\"\\nAdapter saved to {OUTPUT_DIR}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "step8"
   },
   "source": [
    "## Step 8: Test the Fine-Tuned Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "test_model"
   },
   "outputs": [],
   "source": [
    "from peft import PeftModel\n",
    "\n",
    "# Load base + adapter\n",
    "base_model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_ID,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    token=HF_TOKEN,\n",
    ")\n",
    "model = PeftModel.from_pretrained(base_model, OUTPUT_DIR)\n",
    "model.eval()\n",
    "\n",
    "# Test prompts\n",
    "test_prompts = [\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context.\",\n",
    "        \"input\": \"Context: The Paris Agreement was signed in 2015.\\nQuestion: What year was the Paris Agreement signed?\",\n",
    "    },\n",
    "    {\n",
    "        \"instruction\": \"Answer the question using only the provided context.\",\n",
    "        \"input\": \"Context: Solar panels convert sunlight to electricity.\\nQuestion: What is the chemical formula for water?\",\n",
    "    },\n",
    "]\n",
    "\n",
    "for tp in test_prompts:\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": tp[\"instruction\"]},\n",
    "        {\"role\": \"user\", \"content\": tp[\"input\"]},\n",
    "    ]\n",
    "    prompt = tokenizer.apply_chat_template(messages, tokenize=False)\n",
    "    inputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        output = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=200,\n",
    "            temperature=0.1,\n",
    "            do_sample=True,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "        )\n",
    "\n",
    "    response = tokenizer.decode(output[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n",
    "    print(f\"Q: {tp['input'][:100]}...\")\n",
    "    print(f\"A: {response}\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "print(\"\\n=== Fine-tuning complete! ===\")\n",
    "print(f\"Adapter saved to: {OUTPUT_DIR}\")\n",
    "print(f\"Upload this folder to HuggingFace Hub for use in the app.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "notes"
   },
   "source": [
    "## Important Notes\n",
    "\n",
    "1. **Dataset size:** Replace the synthetic examples with 400+ real examples generated by `backend/training_data/generate_dataset.py`.\n",
    "2. **GPU requirement:** T4 GPU is minimum; A100 preferred for faster training.\n",
    "3. **Training time:** ~30-60 min on T4 for 400 examples, 3 epochs.\n",
    "4. **Merge after training:** To merge LoRA with base model for deployment:\n",
    "   ```python\n",
    "   merged = model.merge_and_unload()\n",
    "   merged.save_pretrained(OUTPUT_DIR + '-merged')\n",
    "   ```\n",
    "5. **Cost:** Groq free tier is sufficient for training data generation (use script). Colab T4 is free."
   ]
  }
