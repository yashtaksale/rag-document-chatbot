# =============================================================================
# DocChat Production Dockerfile (Next.js Claude/ChatGPT Frontend)
# =============================================================================

FROM node:20-alpine AS base

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install

COPY . .

RUN npm run build

EXPOSE 3001

ENV PORT=3001
ENV NODE_ENV=production

CMD ["npm", "start"]
