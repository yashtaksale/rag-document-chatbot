# =============================================================================
# DocChat Environment Configuration Template
# Copy this file to .env (or .env.local) and fill in your private API keys.
# DO NOT commit real secrets or API keys to version control.
# =============================================================================

# Deployment Environment ('development' | 'production')
ENVIRONMENT=development
REQUIRE_AUTH=false

# Allowed Origins for CORS (Comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Backend Service URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
DOCCHAT_BACKEND_URL=http://127.0.0.1:8001/api/chat/stream

# Groq / LLM API Key (Required for AI generation)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1

# Model & RAG Pipeline Configuration
DOCCHAT_MODEL=qwen/qwen3.8-27b
DOCCHAT_MAX_RPM=30
DOCCHAT_CHUNK_SIZE=500
DOCCHAT_CHUNK_OVERLAP=50
DOCCHAT_API_TIMEOUT=30

# Demo Seeding (Disabled by default in production)
ALLOW_DEMO_SEEDING=false
# SEED_DEMO_PASSWORD=your_strong_demo_password_123!
# SEED_ADMIN_PASSWORD=your_strong_admin_password_123!

# Session Management
SESSION_DURATION_DAYS=7
